# ==========================================
# VIVADO & XSIM IGNORE LIST
# Bỏ qua các file rác, file sinh tự động, file waveform nặng
# ==========================================

# Xilinx / Vivado project temp folders
.Xil/
*.cache/
*.hw/
*.ip_user_files/

# Log and Journal files
*.jou
*.log
*.str
*.pb

# Simulation heavy files (Database, Waveforms, Compiled objects)
xsim.dir/
*.wdb
*.vcd
*.vpd
*.fsdb
*.asdb

# Bỏ qua toàn bộ các thư mục báo cáo Coverage (vì DB chứa bên trong rất nặng)
xcrg_report/
xcrg_mdb/
xsim.covdb/
xsim.codeCov/
cov_db/

# ==========================================
# NGOẠI LỆ: GIỮ LẠI CÁC FILE QUAN TRỌNG
# ==========================================

# KHÔNG bỏ qua các file HTML (Giữ lại báo cáo Code Coverage dưới dạng Web)
!*.html

# ==========================================
# QUARTUS / INTEL FPGA IGNORE LIST
# Bỏ qua database & output sinh tự động khi compile (tái tạo lại được)
# ==========================================

# Compilation databases (rất nặng, sinh lại mỗi lần compile)
db/
incremental_db/
output_files/
greybox_tmp/
hc_output/
qdb/

# Qsys / GUI state (per-user)
.qsys_edit/
*.qws
*.qarlog
*.rpt.messages

# Áp dụng cho mọi sub-project Quartus (vd: riscv_quartus_pipeline/)
**/db/
**/incremental_db/
**/output_files/

# ==========================================
# TÀI LIỆU PDF (lưu ngoài repo, không version-control)
# ==========================================
*.pdf
*.PDF
